# ==============================================================================
# PresenAI Backend Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED SECRETS (Backend Only - NEVER expose to frontend or commit to Git)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME SETTINGS (Optional)
# ------------------------------------------------------------------------------
APP_NAME="AI Presentation Generator"
ENVIRONMENT=development                # development | test | production
API_HOST=127.0.0.1                     # 0.0.0.0 for containerized execution
API_PORT=8000
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
ENABLE_DOCS=false                      # Explicitly toggle /docs and /redoc

# ------------------------------------------------------------------------------
# 3. CORS ORIGINS (Optional - comma-separated origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. AI MODEL & TIMEOUT CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=60.0
AI_MAX_ATTEMPTS=2

# ------------------------------------------------------------------------------
# 5. STORAGE & CONCURRENCY LIMITS (Optional)
# ------------------------------------------------------------------------------
ARTIFACT_DIR=temp/artifacts
ARTIFACT_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=5
MAX_JOB_RUNTIME_SECONDS=300
