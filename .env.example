# ==============================================================================
# PresenAI Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED SECRETS (Backend Only - NEVER expose to browser)
# ------------------------------------------------------------------------------
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 2. APPLICATION & SERVER SETTINGS (Optional)
# ------------------------------------------------------------------------------
APP_NAME="AI Presentation Generator"
ENVIRONMENT=development                # development | test | production
API_HOST=127.0.0.1                     # Use 0.0.0.0 for Docker containers
API_PORT=8000
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
ENABLE_DOCS=false                      # Enable Swagger /docs in production if true

# ------------------------------------------------------------------------------
# 3. CORS CONFIGURATION (Optional - comma-separated list of allowed origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. AI MODEL SETTINGS (Optional)
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=60.0
AI_MAX_ATTEMPTS=2

# ------------------------------------------------------------------------------
# 5. STORAGE & RESOURCE LIMITS (Optional)
# ------------------------------------------------------------------------------
ARTIFACT_DIR=temp/artifacts
ARTIFACT_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=5
MAX_JOB_RUNTIME_SECONDS=300

# ------------------------------------------------------------------------------
# 6. FRONTEND SETTINGS (Public to browser)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
